RewriteRule ^ph-tax-calculator/?$ /tax-calculator-philippines [R=301,L]
RewriteRule ^people-analytics/?$ /products/people-analytics/ [R=301,L]
RewriteRule ^people-management/?$ /products/people-management/ [R=301,L]
