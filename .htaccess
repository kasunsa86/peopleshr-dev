RewriteRule ^outsourcing/?$ /solutions/outsourcing/ [R=301,L]
RewriteRule ^peopleshr-academy/?$ /solutions/peopleshr-academy/ [R=301,L]
RewriteRule ^cio/?$ /solutions/cio/ [R=301,L]
RewriteRule ^cfo/?$ /solutions/cfo/ [R=301,L]
RewriteRule ^chro/?$ /solutions/chro/ [R=301,L]
RewriteRule ^hr-software-for-transportation-and-logistics-industry/?$ /solutions/hr-software-for-transportation-and-logistics-industry/ [R=301,L]
RewriteRule ^hr-software-for-it-and-ites-industry/?$ /solutions/hr-software-for-it-and-ites-industry/ [R=301,L]
