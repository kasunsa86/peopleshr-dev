RewriteRule ^region-middle-east/?$ /middle-east/ [R=301,L]

# index.html itself always canonicalizes to its folder's root, never to
# "/index/" or "/solutions/index/". These three special cases are matched
# against the RewriteRule's own per-directory pattern space (not
# %{THE_REQUEST}) so they're anchored to the actual filename regardless of
# how deep the site happens to be nested under the server root â€” a plain
# %{THE_REQUEST} anchor like "\s/+index\.html" only matches when index.html
# is the very FIRST path segment after "GET /", which silently fails (and
# falls through to the generic rule below with the wrong result) whenever
# the site isn't served from the true domain root, e.g. local WAMP testing
# from "/Peopleshr HTML/...". Matching the rule pattern itself has no such
# assumption. NE (No Escape) still guards against Apache double-encoding
# any "%"-escaped character in a backreference (e.g. a "%20" from a local
# path with a space) when it's fed back into a new redirect target.
RewriteRule ^index\.html$ /? [R=301,L,NE]
RewriteRule ^([^/]+)/index\.html$ /$1/ [R=301,L,NE]

# solutions.html and products.html both used to need an exception here:
# their clean URL ("/solutions/" / "/products/") is claimed by a
# subfolder that already exists on disk (solutions/cio.html,
# products/core-hr.html, etc.), and neither subfolder had a real
# index.html of its own -- solutions/ had only a stub duplicating the
# homepage hero, products/ had no index file at all (so "/products/"
# 403'd: Options -Indexes blocks the raw directory listing Apache would
# otherwise show). Both are now fixed by giving each subfolder a real
# index.html with the actual hub page's content, so neither .html file
# needs special-casing any more: both 301 into their clean-URL form like
# every other page, and that URL serves real content.

# Any other direct *.html hit 301s to its clean equivalent.
# %{THE_REQUEST} is the ORIGINAL request line, so this only fires for a
# genuine browser/crawler hit on the .html URL â€” not for the internal
# rewrite below (which doesn't change THE_REQUEST), avoiding a redirect
# loop. (This one still needs THE_REQUEST, unlike the three rules above,
# because it must capture and preserve the full path before ".html" â€”
# there's no fixed filename to anchor a plain RewriteRule pattern to.)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[?\s] [NC]
RewriteRule ^ /%1/ [R=301,L,NE]

# Serve the clean URL from its real .html file, invisibly.
# Existing real files/directories (images, css, js, uploads/,
# solutions/ which has its own index.html) are left untouched.
#
# [^/.]+ (not [^/]+) in both patterns -- excluding the dot is what stops
# a MISSING page from looping forever. When the target ".html" file
# doesn't exist, mod_rewrite's [L] still triggers an internal re-run of
# the whole ruleset for the rewritten URI ("whatever.html"); with the
# original [^/]+ pattern that URI matches this SAME rule again (it's just
# another slash-free segment) and gets ANOTHER ".html" appended --
# "whatever.html" -> "whatever.html.html" -> ... -- forever, since it
# never becomes a real file, until Apache's internal-redirect limit (10)
# aborts the request with a 500. Excluding "." from the character class
# means a segment that already ends in ".html" can never match a second
# time, so a genuinely missing page falls through cleanly to the 404
# rule below after exactly one rewrite attempt instead of looping.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/.]+)/([^/.]+)/?$ $1/$2.html [L]

# TEMPORARY BLOG-MIGRATION REDIRECT -- all blog posts have moved off this
# domain to blog.peopleshr.com. A single-segment slug with no matching
# local page here (checked below by testing for "$1.html" on disk, not
# just the extension-less "$1" that every clean URL uses) is assumed to
# be an old post and sent to the same slug on blog.peopleshr.com instead
# of falling through to our own 404. 302 (temporary), not 301, since
# blog.peopleshr.com is explicitly a temporary home for this content --
# remove this block (and the rewrite above stays untouched) once/if that
# changes. Placed before the generic "$1.html" rewrite immediately below
# so a genuine local page (e.g. "company" -> company.html) still wins:
# its .html file exists, so the third condition fails and this rule is
# skipped entirely for it.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html !-f
RewriteRule ^([^/.]+)/?$ https://blog.peopleshr.com/$1/ [R=302,L,NE]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/.]+)/?$ $1.html [L]

# Nothing above matched a real file, directory, or page -- this is a
# genuine 404. Rewrite straight to the real, existing 404.html (see the
# note near the top of this file for why that's a plain rewrite here
# rather than the standard ErrorDocument directive) -- 404.html sets the
# actual 404 status itself via http_response_code(), since a plain
# internal rewrite like this one otherwise defaults to 200.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /404.html [L]

