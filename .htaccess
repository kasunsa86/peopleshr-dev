RewriteRule ^resources/e-book-tech-trends/?$ /hr-ebooks-and-guides/ [R=301,L]
RewriteRule ^2022/05/17/employee-champions-why-you-need-one/?$ /employee-champions-why-you-need-one/ [R=301,L]
RewriteRule ^2021/06/08/what-is-the-role-of-hr-in-customer-experience/?$ /what-is-the-role-of-hr-in-customer-experience/ [R=301,L]
RewriteRule ^2021/03/27/need-real-proof-that-your-employees-are-happy/?$ /need-real-proof-that-your-employees-are-happy/ [R=301,L]
