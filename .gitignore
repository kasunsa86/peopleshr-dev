.DS_Store

# CloudFront origin-lock secret. It belongs in ../PHR Website Deploy/
# (see deploy.sh); these only catch a copy dropped in here by mistake.
origin-lock.txt
.htaccess-origin-lock
PHR Website Deploy/

# Site backups/archives -- never commit (www.zip was a 70 MB copy of the old site).
*.zip

# Files the server creates in the cPanel checkout (dev.peopleshr.com). Left
# untracked, they count as uncommitted changes and disable "Deploy HEAD Commit".
error_log
.well-known/
cgi-bin/
.user.ini
php.ini

# Local dev tools (blog generator, calculator test suite) and virtualenv:
# kept on the developer machine, never deployed.
tools/
.venv/

# Claude Code settings: per-person, never shared. Shared skills (.claude/skills/)
# are the exception, so every Claude builds pages the same way.
.claude/*
!.claude/skills/

# Live quote secrets (HubSpot token). Created by hand on the server; see
# inc/quote-secrets.example.php.
inc/quote-secrets.php

# Downloaded copies of the live .htaccess (e.g. "htaccess (2)"): they hold the
# CloudFront origin-lock secret. The repo copy .htaccess is unaffected.
htaccess*

# Local copy of the live .htaccess (holds the origin-lock secret). Already
# tracked, so it is also marked skip-worktree locally; never commit it.
.htaccess
